<UserControl x:Class="BracketLibraryInventorPlugin.Views.BracketLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="380"
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
             FontFamily="Segoe UI" FontSize="11">

    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="Foreground" Value="#FF0078D4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <TextBlock Text="MCG BRACKET LIBRARY" FontSize="14" FontWeight="Bold"/>
            <TextBlock Text="Pick type · pick faces · adjust parameters · insert"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="9"/>

            <!-- 1. Type = family + thickness -->
            <TextBlock Style="{StaticResource H2}" Text="1 · Family + thickness"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CboFamily" Grid.Column="0" Height="26"
                          ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}"/>
                <ComboBox x:Name="CboThk" Grid.Column="1" Height="26" Margin="6,0,0,0"
                          ItemsSource="{Binding Thicknesses}" SelectedItem="{Binding SelectedThickness}"/>
            </Grid>
            <TextBlock Text="{Binding NotesText}" TextWrapping="Wrap" FontSize="9" Margin="0,4,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

            <!-- 2. Location -->
            <TextBlock Style="{StaticResource H2}" Text="2 · Insert location"/>
            <Button x:Name="BtnPick" Content="Pick location  (Web → Top Plate → HP → Flange)" Height="28" Click="BtnPick_Click"/>
            <TextBlock Text="4 picks: (1) Web face  (2) click a point on the Top Plate face = bracket station  (3) HP face  (4) Flange face. Span_S / Web_Height / Flange_Overhang / Member_Height are measured automatically."
                       TextWrapping="Wrap" FontSize="9" Margin="0,3,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <CheckBox x:Name="ChkFlip" Content="Reverse member direction"
                      IsChecked="{Binding FlipMemberDir}" Margin="0,4,0,0"/>
            <CheckBox x:Name="ChkAutoH" Content="Auto-measure parameters from picked geometry"
                      IsChecked="{Binding AutoMeasureFromPick}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding LocationText}" TextWrapping="Wrap" FontSize="9" Margin="0,4,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <TextBlock Text="{Binding MeasuredText}" TextWrapping="Wrap" FontSize="9" Margin="0,2,0,0"
                       Foreground="#FF0078D4"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <RadioButton x:Name="RbAsm" Content="Assembly (component)" GroupName="ctx"
                             IsChecked="{Binding ContextIsAssembly}" Margin="0,0,10,0"/>
                <RadioButton x:Name="RbPart" Content="Part (feature)" GroupName="ctx"/>
            </StackPanel>

            <!-- 3. Parameters -->
            <TextBlock Style="{StaticResource H2}" Text="3 · Parameters  (mm — become Inventor Parameters)"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Lbl}" Text="Span_S"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding SpanS, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Web_Height"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding WebHeight, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="Member_Height"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding MemberHeight, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Text="Flange_Overhang"/>
                <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding FlangeOverhang, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="4" Style="{StaticResource Lbl}" Text="Plate_Thickness"/>
                <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding PlateThickness, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="5" Style="{StaticResource Lbl}" Text="Lip_Fold_Dir (±1)"/>
                <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding LipFoldDirection, UpdateSourceTrigger=LostFocus}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="BtnFlipLip" Content="Flip lip" Click="BtnFlipLip_Click" Padding="12,3" Margin="0,0,6,0"/>
                <Button x:Name="BtnFlipLipSel" Content="Flip lip on selected bracket" Click="BtnFlipLipSel_Click" Padding="12,3"/>
            </StackPanel>

            <!-- 4. Preview + derived -->
            <TextBlock Style="{StaticResource H2}" Text="4 · Preview + derived values"/>
            <Border BorderThickness="1" CornerRadius="3" Height="210" Margin="0,0,0,6"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="10"/>
            </Border>
            <TextBlock Text="Section preview (mm) — bracket in blue; Web / Top Plate / Flange / HP in grey. Origin at Web∩TopPlate."
                       FontSize="9" Margin="0,0,0,4" TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Border BorderThickness="1" CornerRadius="3" Padding="6"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <TextBlock Text="{Binding DerivedText}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="{Binding WarningText}" Foreground="#FFD32F2F" TextWrapping="Wrap"
                       FontSize="10" Margin="0,4,0,0"/>

            <!-- 5. Insert -->
            <Button x:Name="BtnInsert" Content="INSERT BRACKET" Height="34" Margin="0,12,0,0"
                    FontWeight="Bold" Background="#FF228B22" Foreground="White" BorderThickness="0"
                    IsEnabled="{Binding CanInsert}" Click="BtnInsert_Click"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
